# Copy to .env.local for local development. On Vercel, set the same keys under
# Project → Settings → Environment Variables.

# ── Sanity (Studio at /sanity) ───────────────────────────────────────────────
# Same project and dataset as vomatt-web
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Public site (vomatt-web) ─────────────────────────────────────────────────
# Origin only, no trailing slash. The Studio links pages here.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

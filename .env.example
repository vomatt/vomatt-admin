# Copy to .env.local for local development. On Vercel, set the same keys under
# Project → Settings → Environment Variables.

# ── Sanity (Studio at /sanity) ───────────────────────────────────────────────
# Same project and dataset as vomatt-web
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Public sites ─────────────────────────────────────────────────────────────
# Origins only, no trailing slash. The Studio's View page links go here.
# The app (vomatt-web): Log In
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# The about site (vomatt-about): Pages and the Homepage
NEXT_PUBLIC_ABOUT_URL=http://localhost:3004

# ── vomatt-api ───────────────────────────────────────────────────────────────
# Origin only, no trailing slash
API_URL=http://localhost:8080
# Same value as the API's JWT_SECRET: the proxy verifies access tokens with it
SESSION_SECRET=
